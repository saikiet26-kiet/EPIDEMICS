        "# ============================================================\n",
        "# EPIDEMIC SPREAD OVER N WEEKS (C1)\n",
        "# B.Tech Mathematics Mini Project\n",
        "# Cayley-Hamilton Theorem + Matrix Powers\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import sympy as sp\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. INPUT DATA\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Initial population\n",
        "S0 = 900       # Susceptible\n",
        "I0 = 80        # Infected\n",
        "R0 = 20        # Recovered\n",
        "\n",
        "# Initial state vector\n",
        "x0 = sp.Matrix([\n",
        "    S0,\n",
        "    I0,\n",
        "    R0\n",
        "])\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. WEEKLY TRANSITION MATRIX\n",
        "# ------------------------------------------------------------\n",
        "#\n",
        "# Columns represent the state from which people move.\n",
        "#\n",
        "#       S      I      R\n",
        "# S   0.95   0.00   0.00\n",
        "# I   0.04   0.90   0.00\n",
        "# R   0.01   0.10   1.00\n",
        "#\n",
        "# Interpretation:\n",
        "# 95% of susceptible people remain susceptible\n",
        "# 4% of susceptible people become infected\n",
        "# 1% of susceptible people recover/leave the model\n",
        "#\n",
        "# 90% of infected people remain infected\n",
        "# 10% of infected people recover\n",
        "#\n",
        "# 100% of recovered people remain recovered\n",
        "#\n",
        "# NOTE:\n",
        "# This is a simplified educational transition model,\n",
        "# not a clinical COVID-19 prediction model.\n",
        "\n",
        "A = sp.Matrix([\n",
        "    [sp.Rational(95, 100), 0,                       0],\n",
        "    [sp.Rational(4, 100),  sp.Rational(90, 100),    0],\n",
        "    [sp.Rational(1, 100),  sp.Rational(10, 100),    1]\n",
        "])\n",
        "\n",
        "N = 52\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. DISPLAY INPUT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"=\" * 65)\n",
        "print(\"       EPIDEMIC SPREAD OVER 52 WEEKS\")\n",
        "print(\"       Cayley-Hamilton Matrix Model\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "print(\"\\nInitial Population:\")\n",
        "print(\"Susceptible :\", S0)\n",
        "print(\"Infected    :\", I0)\n",
        "print(\"Recovered   :\", R0)\n",
        "print(\"Total       :\", S0 + I0 + R0)\n",
        "\n",
        "print(\"\\nWeekly Transition Matrix A:\")\n",
        "sp.pprint(A)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. CHARACTERISTIC EQUATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "lam = sp.symbols('λ')\n",
        "\n",
        "characteristic_polynomial = A.charpoly(lam).as_expr()\n",
        "\n",
        "print(\"\\n\" + \"-\" * 65)\n",
        "print(\"CHARACTERISTIC EQUATION\")\n",
        "print(\"-\" * 65)\n",
        "\n",
        "print(\"Characteristic Polynomial:\")\n",
        "sp.pprint(characteristic_polynomial)\n",
        "\n",
        "print(\"\\nCharacteristic Equation:\")\n",
        "print(\"det(λI - A) = 0\")\n",
        "sp.pprint(sp.Eq(characteristic_polynomial, 0))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. CAYLEY-HAMILTON THEOREM\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"-\" * 65)\n",
        "print(\"CAYLEY-HAMILTON THEOREM\")\n",
        "print(\"-\" * 65)\n",
        "\n",
        "print(\"\\nThe characteristic polynomial is:\")\n",
        "sp.pprint(characteristic_polynomial)\n",
        "\n",
        "print(\"\\nBy Cayley-Hamilton, replace λ by A:\")\n",
        "\n",
        "# Extract coefficients\n",
        "poly = sp.Poly(characteristic_polynomial, lam)\n",
        "coefficients = poly.all_coeffs()\n",
        "\n",
        "c0 = coefficients[0]\n",
        "c1 = coefficients[1]\n",
        "c2 = coefficients[2]\n",
        "c3 = coefficients[3]\n",
        "\n",
        "print(\"\\nGeneral form:\")\n",
        "print(\"A^3 + c1*A^2 + c2*A + c3*I = 0\")\n",
        "\n",
        "print(\"\\nFor this matrix:\")\n",
        "\n",
        "print(\n",
        "    f\"{c0}A^3 + ({c1})A^2 + ({c2})A + ({c3})I = 0\"\n",
        ")\n",
        "\n",
        "print(\"\\nTherefore:\")\n",
        "\n",
        "A3_reduced = -c1 * A**2 - c2 * A - c3 * sp.eye(3)\n",
        "\n",
        "print(\"A^3 =\")\n",
        "sp.pprint(A3_reduced)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. CALCULATE A^52 USING CAYLEY-HAMILTON\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"-\" * 65)\n",
        "print(\"CALCULATING A^52\")\n",
        "print(\"-\" * 65)\n",
        "\n",
        "# Direct symbolic power gives the exact mathematical result.\n",
        "# Cayley-Hamilton is used to explain/reduce higher powers.\n",
        "A52 = A ** N\n",
        "\n",
        "print(\"\\nA^52 =\")\n",
        "sp.pprint(A52)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. CALCULATE POPULATION AFTER 52 WEEKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "x52 = A52 * x0\n",
        "\n",
        "print(\"\\n\" + \"-\" * 65)\n",
        "print(\"POPULATION AFTER 52 WEEKS\")\n",
        "print(\"-\" * 65)\n",
        "\n",
        "print(\"\\nX(52) = A^52 X(0)\")\n",
        "\n",
        "print(\"\\nSusceptible after 52 weeks:\",\n",
        "      float(x52[0]))\n",
        "\n",
        "print(\"Infected after 52 weeks   :\",\n",
        "      float(x52[1]))\n",
        "\n",
        "print(\"Recovered after 52 weeks  :\",\n",
        "      float(x52[2]))\n",
        "\n",
        "print(\"Total population          :\",\n",
        "      float(sum(x52)))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. CALCULATE EPIDEMIC EVOLUTION FOR 52 WEEKS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "states = []\n",
        "\n",
        "current_state = x0\n",
        "\n",
        "for week in range(N + 1):\n",
        "\n",
        "    S = float(current_state[0])\n",
        "    I = float(current_state[1])\n",
        "    R = float(current_state[2])\n",
        "\n",
        "    states.append([week, S, I, R])\n",
        "\n",
        "    current_state = A * current_state\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. DISPLAY WEEKLY TABLE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"-\" * 65)\n",
        "print(\"EPIDEMIC EVOLUTION OVER 52 WEEKS\")\n",
        "print(\"-\" * 65)\n",
        "\n",
        "print(\n",
        "    f\"{'Week':>5} {'Susceptible':>15} \"\n",
        "    f\"{'Infected':>15} {'Recovered':>15}\"\n",
        ")\n",
        "\n",
        "print(\"-\" * 55)\n",
        "\n",
        "for row in states:\n",
        "    week, S, I, R = row\n",
        "\n",
        "    print(\n",
        "        f\"{int(week):5d} \"\n",
        "        f\"{S:15.2f} \"\n",
        "        f\"{I:15.2f} \"\n",
        "        f\"{R:15.2f}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. FIND STEADY STATE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\n\" + \"-\" * 65)\n",
        "print(\"STEADY STATE\")\n",
        "print(\"-\" * 65)\n",
        "\n",
        "print(\"\\nSteady state satisfies:\")\n",
        "print(\"A x* = x*\")\n",
        "\n",
        "print(\"\\nTherefore:\")\n",
        "print(\"(A - I)x* = 0\")\n",
        "\n",
        "steady_matrix = A - sp.eye(3)\n",
        "\n",
        "print(\"\\nA - I =\")\n",
        "sp.pprint(steady_matrix)\n",
        "\n",
        "null_space = steady_matrix.nullspace()\n",
        "\n",
        "if len(null_space) > 0:\n",
        "\n",
        "    steady_vector = null_space[0]\n",
        "\n",
        "    print(\"\\nSteady-state eigenvector:\")\n",
        "    sp.pprint(steady_vector)\n",
        "\n",
        "    # Normalize to total population\n",
        "    total_population = S0 + I0 + R0\n",
        "\n",
        "    steady_sum = sum(steady_vector)\n",
        "\n",
        "    normalized_steady = (\n",
        "        steady_vector / steady_sum\n",
        "    ) * total_population\n",
        "\n",
        "    print(\"\\nNormalized steady-state population:\")\n",
        "\n",
        "    print(\n",
        "        \"Susceptible :\",\n",
        "        float(normalized_steady[0])\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Infected    :\",\n",
        "        float(normalized_steady[1])\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Recovered   :\",\n",
        "        float(normalized_steady[2])\n",
        "    )\n",
        "\n",
        "else:\n",
        "    print(\"\\nNo non-zero steady state found.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. GRAPH DATA\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "weeks = [row[0] for row in states]\n",
        "susceptible = [row[1] for row in states]\n",
        "infected = [row[2] for row in states]\n",
        "recovered = [row[3] for row in states]\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 12. PLOT EPIDEMIC EVOLUTION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.plot(\n",
        "    weeks,\n",
        "    susceptible,\n",
        "    marker='o',\n",
        "    label='Susceptible (S)'\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    weeks,\n",
        "    infected,\n",
        "    marker='o',\n",
        "    label='Infected (I)'\n",
        ")\n",
        "\n",
        "plt.plot(\n",
